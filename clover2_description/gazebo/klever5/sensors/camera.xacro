<?xml version="1.0"?>
<sdf xmlns:xacro="http://www.ros.org/wiki/xacro" version="1.9">
  <xacro:macro name="sdf_camera_sensor" params="name settings xyz:='0 0 0' rpy:='0 0 0'">
    <!-- Gazebo camera uses housing axes (+X forward); ROS bridge uses optical frame. -->
    <sensor name="${name}" type="camera">
      <pose>${xyz} ${rpy}</pose>
      <always_on>true</always_on><update_rate>${settings['update_rate']}</update_rate>
      <camera>
        <horizontal_fov>${settings['horizontal_fov']}</horizontal_fov>
        <image><width>${settings['width']}</width><height>${settings['height']}</height><format>R8G8B8</format></image>
        <clip><near>${settings['near']}</near><far>${settings['far']}</far></clip>
      </camera>
    </sensor>
  </xacro:macro>
</sdf>
