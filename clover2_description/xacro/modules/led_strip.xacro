<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="../common/geometry.xacro"/>
  <xacro:macro name="description_led_strip" params="parent xyz rpy name:='led_strip_link'">
    <xacro:property name="physics" value="${component_physics['led_strip']}"/>
    <link name="${name}">
      <xacro:physical_box physics="${physics}"/>
    </link>
    <xacro:mount name="${name}_joint" parent="${parent}" child="${name}"
      xyz="${xyz}" rpy="${rpy}"/>
  </xacro:macro>
</robot>
