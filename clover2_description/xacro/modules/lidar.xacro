<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="description_lidar" params="parent config name:='laser'">
    <xacro:mesh_link name="${name}" mesh="modules/lidar.dae"/>
    <xacro:mount name="${name}_joint" parent="${parent}" child="${name}"
      xyz="${config['xyz']}" rpy="${config['rpy']}"/>
  </xacro:macro>
</robot>
