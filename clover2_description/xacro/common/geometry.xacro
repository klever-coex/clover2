<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Approximate box inertias and collision geometry; hardware parameters are supplied by component macros. -->
  <xacro:macro name="physical_box" params="physics">
    <xacro:property name="m" value="${physics['mass']}"/>
    <xacro:property name="s" value="${physics['inertia_size']}"/>
    <inertial>
      <origin xyz="${' '.join(str(v) for v in physics['com'])}" rpy="0 0 0"/>
      <mass value="${m}"/>
      <inertia ixx="${m*(s[1]**2+s[2]**2)/12}" iyy="${m*(s[0]**2+s[2]**2)/12}"
               izz="${m*(s[0]**2+s[1]**2)/12}" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <collision>
      <origin xyz="${' '.join(str(v) for v in physics['collision_xyz'])}" rpy="0 0 0"/>
      <geometry><box size="${' '.join(str(v) for v in physics['collision_size'])}"/></geometry>
    </collision>
  </xacro:macro>
  <xacro:macro name="mesh_link" params="name mesh physics xyz:='0 0 0' rpy:='0 0 0'">
    <link name="${name}">
      <xacro:physical_box physics="${physics}"/>
      <visual>
        <origin xyz="${xyz}" rpy="${rpy}"/>
        <geometry><mesh filename="package://clover2_description/meshes/${mesh}"/></geometry>
      </visual>
    </link>
  </xacro:macro>
  <xacro:macro name="mount" params="name parent child xyz rpy">
    <joint name="${name}" type="fixed">
      <parent link="${parent}"/><child link="${child}"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>
  </xacro:macro>
</robot>
