<?xml version='1.0' encoding='UTF-8'?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>clover2_camera_utils</name>
  <version>0.2.0</version>
  <description>Clover2 camera and image utilities</description>
  <maintainer email="dan.shakuev@yandex.ru">shakuevda</maintainer>
