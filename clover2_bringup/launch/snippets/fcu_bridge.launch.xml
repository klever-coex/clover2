<launch>
    <arg name="fcu_conn" default="uart" />
    <arg name="protocol" default="mavros" />

    <arg name="use_sim_time" default="false" />
    <arg name="ns" default="" />
    <arg name="params_file" default="$(find-pkg-share clover2_bringup)/params/klever5.yaml" />

    <fcu_bridge
        fcu_conn="$(var fcu_conn)"
        mavros_params_file="$(find-pkg-share clover2_bringup)/params/mavros_default.yaml"
        protocol="$(var protocol)"
        backend="$(var protocol)"
        namespace="$(var ns)">

        <!-- TODO: check if needed -->
        <param name="use_sim_time" value="$(var use_sim_time)" />
    </fcu_bridge>
</launch>