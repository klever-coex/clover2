<launch>
  <arg name="enable_main_camera" default="true"/>
  <arg name="enable_front_camera" default="false"/>
  <arg name="enable_lidar" default="false"/>
  <arg name="enable_led_strip" default="false"/>
  <arg name="use_sim_time" default="false"/>
  <arg name="ns" default=""/>
  <include file="$(find-pkg-share clover2_description)/launch/description.launch.xml">
    <arg name="enable_main_camera" value="$(var enable_main_camera)"/>
    <arg name="enable_front_camera" value="$(var enable_front_camera)"/>
    <arg name="enable_lidar" value="$(var enable_lidar)"/>
    <arg name="enable_led_strip" value="$(var enable_led_strip)"/>
    <arg name="use_sim_time" value="$(var use_sim_time)"/>
    <arg name="ns" value="$(var ns)"/>
  </include>
</launch>
