<launch>
    <arg name="localization" default="true" />
    <arg name="localization.map_server" default="true" />
    <arg name="localization.map" default="example-1.yaml" />
    <arg name="localization.aruco_tracker" default="true" />

    <arg name="main_camera" default="true" />
    <arg name="main_camera.feature_detector" default="true" />
    <arg name="main_camera.optical_flow" default="true" />

    <arg name="front_camera" default="true" />

    <arg name="fcu_bridge" default="true" />
    <arg name="fcu_bridge.fcu_conn" default="uart" />

    <arg name="2d_lidar" default="true" />

    <arg name="use_sim_time" default="false" />
    <arg name="sensing_pkg" default="clover2_bringup" />
    <arg name="root_ns" default="" description="Should starts with / or be empty" />
    <arg name="param_file" default="$(find-pkg-share clover2_bringup)/params/klever5.yaml" />

    <include file="$(find-pkg-share clover2_bringup)/launch/description.launch.xml" />

    <include file="$(find-pkg-share clover2_bringup)/launch/vision/camera_pipeline.launch.xml" if="$(var main_camera)">
        <arg name="use_sim_time" value="$(var use_sim_time)" />
        <arg name="param_file" value="$(var param_file)" />

        <arg name="camera_id" value="0" />
        <arg name="camera_name" value="main_camera" />
        <arg name="ns" value="$(var root_ns)" />
        <arg name="sensing_pkg" value="$(var sensing_pkg)" />

        <arg name="map_server_node" value="$(var root_ns)/map_server" />
        <arg name="feature_detector" value="$(var main_camera.feature_detector)" />
        <arg name="optical_flow" value="$(var main_camera.optical_flow)" />
    </include>

    <include file="$(find-pkg-share clover2_bringup)/launch/vision/camera_pipeline.launch.xml" if="$(var front_camera)">
        <arg name="use_sim_time" value="$(var use_sim_time)" />
        <arg name="param_file" value="$(var param_file)" />

        <arg name="camera_id" value="1" />
        <arg name="camera_name" value="front_camera" />
        <arg name="ns" value="$(var root_ns)" />
        <arg name="sensing_pkg" value="$(var sensing_pkg)" />

        <arg name="map_server_node" value="$(var root_ns)/map_server" />
        <arg name="feature_detector" value="false" />
        <arg name="optical_flow" value="false" />
    </include>

    <include file="$(find-pkg-share clover2_bringup)/launch/snippets/fcu_bridge.launch.xml" if="$(var fcu_bridge)">
        <arg name="use_sim_time" value="$(var use_sim_time)" />
        <arg name="param_file" value="$(var param_file)" />
        <arg name="ns" value="$(var root_ns)" />

        <arg name="fcu_conn" value="$(var fcu_bridge.fcu_conn)" />
    </include>

    <include file="$(find-pkg-share clover2_bringup)/launch/snippets/localization.launch.xml" if="$(var localization)">
        <arg name="use_sim_time" value="$(var use_sim_time)" />
        <arg name="param_file" value="$(var param_file)" />

        <arg name="ns" value="$(var root_ns)" />
        <arg name="feature_detector_node" value="$(var root_ns)/main_camera/cam_feature" />
        <arg name="output_pose_topic" value="$(var root_ns)/mavros/clover2_vio/pose_cov" />

        <arg name="map_server" value="$(var localization.map_server)" />
        <arg name="aruco_tracker" value="$(var localization.aruco_tracker)" />
    </include>

    <include file="$(find-pkg-share clover2_bringup)/launch/web_support.launch.xml">
        <arg name="use_sim_time" value="$(var use_sim_time)" />
        <arg name="param_file" value="$(var param_file)" />
        <arg name="ns" value="$(var root_ns)" />
    </include>

    <include file="$(find-pkg-share $(var sensing_pkg))/launch/sensing/2d_lidar.launch.xml">
        <arg name="param_file" value="$(var param_file)" />
        <arg name="ns" value="$(var root_ns)" />
    </include>
</launch>
