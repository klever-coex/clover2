<launch>
    <arg name="use_sim_time" default="false" />

    <arg name="camera_node" default="camera" />
    <arg name="container_name" default="camera_container" />
    <arg name="ns" default="" />
    <arg name="use_composition" default="false" />

    <node pkg="clover2_optical_flow" exec="optical_flow" name="optical_flow" namespace="$(var ns)" unless="$(var use_composition)">

        <remap from="~/input/image" to="/$(var camera_node)/image" />
        <remap from="~/input/camera_info" to="/$(var camera_node)/camera_info" />

        <param name="use_sim_time" value="$(var use_sim_time)" />
        <param name="roi" value="256" />
    </node>

    <load_composable_node target="$(var container_name)">
        <composable_node pkg="clover2_optical_flow" plugin="clover2::optical_flow::optical_flow" name="optical_flow" namespace="$(var ns)" if="$(var use_composition)">

            <remap from="~/input/image" to="/$(var camera_node)/image" />
            <remap from="~/input/camera_info" to="/$(var camera_node)/camera_info" />

            <param name="use_sim_time" value="$(var use_sim_time)" />
            <param name="roi" value="256" />
        </composable_node>
    </load_composable_node>
</launch>
