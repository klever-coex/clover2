<launch>
    <arg name="use_sim_time" default="false" />
    <arg name="ns" default="" />
    <arg name="param_file" default="$(find-pkg-share clover2_bringup)/params/klever5.yaml" />

    <node pkg="web_video_server" exec="web_video_server" name="web_video_server" namespace="$(var ns)">
        <param name="use_sim_time" value="$(var use_sim_time)" />

        <param from="$(var param_file)" />
    </node>
</launch>
