<launch>
    <arg name="use_sim_time" default="false" />

    <node pkg="diagnostic_common_diagnostics" exec="cpu_monitor.py" name="cpu_monitor">
        <param name="use_sim_time" value="$(var use_sim_time)" />
        <param name="warning_percentage" value="85" />
        <param name="window" value="1" />
    </node>

    <node pkg="diagnostic_aggregator" exec="aggregator_node" name="analyzers">
        <param name="use_sim_time" value="$(var use_sim_time)" />
        <param from="$(find-pkg-share clover2_ui)/config/diagnostic_aggregator.yaml" />
    </node>
</launch>
